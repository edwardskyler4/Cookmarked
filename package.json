{
  "name": "recipe-app",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "packageManager": "pnpm@10.17.1",
  "scripts": {
    "dev": "vite",
    "build": "pnpm run typecheck && vite build",
    "preview": "vite preview",
    "test": "vitest",
    "test:run": "vitest run",
    "test:db": "bash scripts/test-auth-db.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "deploy": "node scripts/release.mjs frontend",
    "preview:cloudflare": "pnpm run build && wrangler dev",
    "typecheck": "tsc -p tsconfig.app.json --noEmit --incremental false",
    "check:edge": "node scripts/check-edge.mjs",
    "check": "pnpm run typecheck && pnpm run check:edge && pnpm run lint && pnpm run test:run && pnpm run build",
    "deploy:functions": "node scripts/release.mjs functions",
    "check:cors": "node scripts/check-cors.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.57.4",
    "react": "^19.1.1",
    "react-dom": "^19.1.1"
  },
  "devDependencies": {
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.1.13",
    "@types/react-dom": "^19.1.9",
    "@typescript-eslint/parser": "^8.44.0",
    "@vitejs/plugin-react": "^5.0.4",
    "eslint": "^9.36.0",
    "jsdom": "^30.1.1",
    "prettier": "^3.6.2",
    "supabase": "^2.120.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.7",
    "vitest": "^3.2.4",
    "wrangler": "^4.141.0"
  }
}
